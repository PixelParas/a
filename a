#!/usr/bin/env bash

# ==============================================================================
# Script Name: cli-desktop-lab.sh
# Description: Automates the setup, terminal tasks, and cleanup for the 
#              "Access the Command Line with the Desktop" guided exercise.
# ==============================================================================

# Exit immediately if a command exits with a non-zero status
set -e

# 1. Prepare the environment
echo "========================================================"
echo "Step 1: Preparing the lab environment..."
echo "========================================================"
lab start cli-desktop

# 2. GUI Login Reminder
echo ""
echo "========================================================"
echo "Step 2: GNOME Desktop Login"
echo "========================================================"
echo "-> Action required: Ensure you are logged into the GNOME 40"
echo "   desktop as user 'student' with password 'student'."
read -p "Press [Enter] once you are logged into the desktop and ready to continue..."

# 3. Change the password
echo ""
echo "========================================================"
echo "Step 3: Changing the password for user 'student'..."
echo "========================================================"
echo "You will now be prompted to change your password."
echo "Current Password: student"
echo "New Password:     55TurnK3y"
echo ""

# Using passwd interactively or via chpasswd for automation script safety:
# (Note: In a true interactive shell, the user runs 'passwd')
echo -e "student\n55TurnK3y\n55TurnK3y" | passwd

echo ""
echo "Password successfully updated!"

# 4. Verification and GUI Interactions Reminder
echo ""
echo "========================================================"
echo "Step 4: GUI Verification & Testing"
echo "========================================================"
echo "Please perform the following manual checks in your GNOME desktop:"
echo "  1. Log out (System Menu -> Power Off/Log Out -> Log Out)."
echo "  2. Log back in using your NEW password ('55TurnK3y')."
echo "  3. Lock the screen (System Menu -> Lock button)."
echo "  4. Unlock the screen using '55TurnK3y'."
echo "  5. Test Power Off (System Menu -> Power Off/Log Out -> Power Off)"
     and click [Cancel]."
echo ""
read -p "Press [Enter] after you have completed these desktop verification steps..."

# 5. Finish and Cleanup
echo ""
echo "========================================================"
echo "Step 5: Cleaning up and finishing the lab..."
echo "========================================================"
cd ~
lab finish cli-desktop

echo ""
echo "Lab 'cli-desktop' completed successfully!"