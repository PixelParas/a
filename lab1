#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------------------------
# Human Typing Simulation Helper
# ------------------------------------------------------------------------------
type_and_run() {
    local cmd="$1"
    # Match standard Red Hat / Fedora lab prompt format
    local prompt="[student@desktop ~]$ "
    
    echo -n "$prompt"
    
    # Simulate realistic keystroke timing with slight random delays
    for (( i=0; i<${#cmd}; i++ )); do
        echo -n "${cmd:$i:1}"
        sleep "0.0$(( RANDOM % 4 + 3 ))"
    done
    echo
    sleep 0.6
    
    # Execute the actual command
    eval "$cmd"
    sleep 1
}

# ------------------------------------------------------------------------------
# Interactive Lab Execution
# ------------------------------------------------------------------------------

# Clear screen to start on a clean terminal slate
clear

# Step 1: Start the lab
type_and_run "lab start cli-desktop"

echo
# Pause briefly as if checking the desktop GUI
sleep 2

# Step 2: Change password interactively
type_and_run "passwd"

echo
# Simulate brief pause before testing GUI tasks
sleep 2

# Step 3: GUI Verification Pause
read -r -p "[student@desktop ~]$ " _

# Step 4: Cleanup
type_and_run "cd ~"
type_and_run "lab finish cli-desktop"
